# ── Anthropic ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe ─────────────────────────────────────────
# Haal op via dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Maak twee Prices aan in Stripe dashboard:
# 1. Maandabonnement: recurring, €5,99/maand
STRIPE_PRICE_ID=price_...
# 2. Eenmalig document: one-time, €3,49
STRIPE_PRICE_ID_SINGLE=price_...

# ── JWT ────────────────────────────────────────────
# Willekeurige lange string — gebruik: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=vervang_dit_met_een_willekeurige_lange_string

# ── Google OAuth ────────────────────────────────────
# Zelfde Client ID als in de frontend
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# ── Server ─────────────────────────────────────────
PORT=3000
# Zet dit op uw frontend domein (bijv. https://klarify.nl)
ALLOWED_ORIGIN=http://localhost:3000

# ── Abonnementsinstelling ───────────────────────────
# Prijs in euro (alleen voor weergave)
PLAN_PRICE_EUR=7.99
PLAN_NAME=Klarify Pro
